<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#0A0A1E">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌙 Lunar Phase Monitor"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Moon Phase SeekBar (Disabled) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Moon Phase Progress"
            android:textSize="16sp"
            android:textColor="#CCCCCC"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/moonPhaseSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:enabled="false"
            android:progressTint="#FFD700"
            android:thumbTint="#FFD700"
            android:progressBackgroundTint="#333333" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="New"
                android:textSize="12sp"
                android:textColor="#999999"
                android:gravity="start" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="First"
                android:textSize="12sp"
                android:textColor="#999999"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Full"
                android:textSize="12sp"
                android:textColor="#999999"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Last"
                android:textSize="12sp"
                android:textColor="#999999"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="New"
                android:textSize="12sp"
                android:textColor="#999999"
                android:gravity="end" />

        </LinearLayout>

    </LinearLayout>

    <!-- Current Phase Data -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A2E"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Lunar Data"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/phasePercentageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phase: 0.0%"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/illuminationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Illumination: 0.0%"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/phaseNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phase: New Moon"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/moonAgeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Moon Age: 0.0 days"
            android:textSize="16sp"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- Upcoming Events -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A2E"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upcoming Events"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/nextNewMoonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Next New Moon: Loading..."
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/nextFullMoonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Next Full Moon: Loading..."
            android:textSize="16sp"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- Note about disabled SeekBar -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Note: The progress bar automatically tracks the moon's current phase and cannot be moved manually."
        android:textSize="12sp"
        android:textColor="#999999"
        android:textStyle="italic"
        android:layout_marginTop="16dp"
        android:gravity="center" />

</LinearLayout>
