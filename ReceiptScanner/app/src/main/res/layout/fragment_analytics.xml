<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.analytics.AnalyticsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Analytics"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Total Spending -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorSurfaceVariant"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Spending"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/total_spending_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="$0.00"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:text="$83.49" />

        </LinearLayout>

        <!-- Monthly Spending -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorSurfaceVariant"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This Month"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/monthly_spending_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="$0.00"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:text="$45.00" />

        </LinearLayout>

        <!-- Receipt Count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorSurfaceVariant"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Receipts: "
                android:textSize="16sp" />

            <TextView
                android:id="@+id/receipt_count_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="3" />

        </LinearLayout>

        <!-- Categories Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="Spending by Category"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/category_breakdown_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:background="?attr/colorSurfaceVariant"
            android:gravity="center"
            android:padding="16dp"
            android:text="No data available"
            android:textSize="16sp"
            tools:text="Groceries: $25.50\nFood &amp; Dining: $45.00" />

    </LinearLayout>

</ScrollView>

